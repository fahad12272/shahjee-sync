# ==========================================================
# SHAHJEE SYNC — Environment Variables
# Is file ko .env naam se copy karo aur apni values bharo:
#   cp .env.example .env
# Vercel pe deploy karte waqt ye SAME vars
# Vercel > Settings > Environment Variables mein daalo.
# ==========================================================

# ---- ZAROORI (app chalane ke liye) ----
# MongoDB Atlas se: Cluster > Connect > Drivers > connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/shahjee-sync

# Lamba random secret khud banao (32+ characters) — passwords ke tokens isi se bante hain
JWT_SECRET=apna-lamba-random-secret-yahan-likhein

# Scheduler endpoint ka secret — cron job isko Bearer token ke roop mein bhejta hai
CRON_SECRET=scheduler-ka-secret-random-string

# Tumhari deployed site ka URL (password reset links isi pe bante hain)
APP_URL=https://shahjee-sync.vercel.app

# ---- MEDIA UPLOAD (cloudinary.com — free account) ----
# Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- EMAIL / PASSWORD RESET (Gmail App Password) ----
# 1. Google Account > Security > 2-Step Verification ON karo
# 2. Google Account > Security > App passwords > 16-char password generate karo
# 3. Wahi 16-char password SMTP_PASS mein daalo (normal Gmail password NAHI chalega)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---- FRONTEND (optional — default "/api" same-domain ke liye) ----
# Frontend local pe alag backend ko hit kare to backend ka URL do
VITE_API_URL=/api

# ---- X (TWITTER) 1-CLICK OAUTH (recommended — users ko keys nahi lani padengi) ----
# developer.x.com > apni App > User authentication settings > OAuth 2.0 setup karo:
#   App permissions: Read and write | Type of App: Web App
#   Callback URI: https://shahjee-sync.vercel.app/api/platforms/x/oauth/callback
#   Website URL: https://shahjee-sync.vercel.app
# Phir "Keys and tokens" tab se OAuth 2.0 Client ID aur Client Secret yahan dalo
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# ---- META FAMILY (Facebook Pages + Instagram + Threads) 1-CLICK OAUTH — FREE ----
# developers.facebook.com > apni App > Settings > Basic > App ID + App Secret
# App ke "Valid OAuth Redirect URIs" mein TEENO add karo:
#   https://shahjee-sync.vercel.app/api/platforms/facebook/oauth/callback
#   https://shahjee-sync.vercel.app/api/platforms/instagram/oauth/callback
#   https://shahjee-sync.vercel.app/api/platforms/threads/oauth/callback
META_APP_ID=
META_APP_SECRET=

# ---- LINKEDIN 1-CLICK OAUTH — 100% FREE (koi fees nahi) ----
# linkedin.com/developers/apps > Create app (LinkedIn Page chahiye hoti hai)
# Products tab: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# dono add karo (approval instant milti hai)
# Auth tab > Redirect URLs:
#   https://shahjee-sync.vercel.app/api/platforms/linkedin/oauth/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---- X (TWITTER) DIRECT POSTING (aane wala feature — improvement #4) ----
# developer.x.com pe app banao, permissions "Read and Write" rakho
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
